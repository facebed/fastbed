 #include "nghttp2_helper.h"
 #include "nghttp2_priority_spec.h"
 
+/*
+ * Preserve the RFC 7540 priority bytes used by curl-impersonate browser
+ * profiles.  nghttp2 1.65 removed dependency scheduling and made the public
+ * submission APIs no-ops, but the frame encoder and outbound queues remain.
+ * This deliberately restores only outbound wire serialization; it does not
+ * restore the removed scheduler or inbound dependency tree.
+ */
+static int detect_self_dependency(nghttp2_session *session, int32_t stream_id,
+                                  const nghttp2_priority_spec *pri_spec) {
+  assert(pri_spec);
+
+  if (stream_id == -1) {
+    return (int32_t)session->next_stream_id == pri_spec->stream_id
+             ? NGHTTP2_ERR_INVALID_ARGUMENT
+             : 0;
+  }
+
+  return stream_id == pri_spec->stream_id ? NGHTTP2_ERR_INVALID_ARGUMENT : 0;
+}
