{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastbed.invalid/schema/runtime-inventory-1.json",
  "title": "Fastbed runtime inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image_id",
    "image_architecture",
    "image_reference",
    "build_receipt",
    "embedded_resources",
    "packages",
    "files"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "image_architecture": { "enum": ["amd64", "arm64"] },
    "image_reference": { "type": "string", "minLength": 1 },
    "build_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "document"],
      "properties": {
        "path": { "const": "/usr/local/share/fastbed/BUILD-RECEIPT.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "document": { "type": "object" }
      }
    },
    "embedded_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "document"],
      "properties": {
        "path": { "const": "/usr/local/share/fastbed/EMBEDDED-RESOURCES.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "document": { "type": "object" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "architecture",
          "license",
          "origin",
          "apk_checksum"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9+_.-]*$" },
          "version": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "apk_checksum": { "type": "string", "pattern": "^Q1[0-9A-Za-z+/]+=*$" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "build_id": { "type": "string", "pattern": "^[0-9a-f]{16,128}$" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
